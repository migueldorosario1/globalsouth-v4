---
const today = new Date();
---

<footer>
	<p class="footer-brand">GLOBAL <span class="accent-text">SOUTH</span> NEWS</p>
	<p>&copy; {today.getFullYear()} All rights reserved.</p>
	<p class="footer-note">A newsroom for development, sovereignty and multipolar politics.</p>
	<div class="group-tag">Part of the <a href="https://cafezinhomediagroup.vercel.app/" target="_blank" rel="noopener">Cafezinho Media Group</a></div>
</footer>

<style>
	footer {
		padding: 4rem 1.5rem 5rem;
		background: var(--bg-card);
		border-top: 1px solid var(--border-color);
		color: var(--text-muted);
		text-align: center;
		font-family: var(--font-headings);
	}

	.footer-brand {
		font-weight: 800;
		font-size: 1rem;
		letter-spacing: 0.15em;
		color: var(--text-title);
		margin-bottom: 0.75rem !important;
	}

	.accent-text {
		color: var(--accent);
	}

	footer p {
		margin: 0.45rem 0;
		font-size: 0.85rem;
	}

	.footer-note {
		font-size: 0.8rem;
		opacity: 0.85;
		max-width: 500px;
		margin: 1rem auto 0 auto !important;
		line-height: 1.5;
	}
	.group-tag {
		margin-top: 1.2em;
		font-size: 0.72em;
		letter-spacing: 0.04em;
		opacity: 0.75;
	}
	.group-tag a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px dotted currentColor;
	}
	.group-tag a:hover {
		opacity: 1;
	}
</style>
